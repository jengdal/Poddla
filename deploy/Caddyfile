{
	servers {
		# If this Caddy is behind a HTTPS proxy, it needs to be trusted.
		# If TRUSTED_PROXIES is unset we use an impossible CIDR, trusting no proxy.
		# Remove this if you don't need it.
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/32}
	}
}

# Tip: Specify protocol and port in SITE_ADDRESS:
# - http://poddla.example.com:8080 if you only want http on port 8080.
# - https://poddla.example.com for https.
{$SITE_ADDRESS} {
	reverse_proxy {$PODDLA_ADDRESS} {
		# Caddy serves the media files. Our Django view hands off the
		# filepath it wants Caddy to serve by way of the
		# x-accel-redirect header.
		@accel header X-Accel-Redirect *
		handle_response @accel {
			root {$MEDIA_ROOT}
			rewrite {rp.header.X-Accel-Redirect}
			method GET
			file_server
		}
	}
}
